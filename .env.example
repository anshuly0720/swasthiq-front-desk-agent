# Copy to .env and fill in. The tool layer never reads these.
# Only the conversation layer (Day 2) calls a model.

LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# Deterministic decoding. Do not raise.
LLM_TEMPERATURE=0

# Cache identical extraction requests on disk. Disclosed in DECISIONS.md.
# Set to 0 when measuring determinism honestly.
LLM_CACHE=1
LLM_ENABLED=1